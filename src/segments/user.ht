import { SpotifyGqlApi } from '../../dependencies/hetu_spotify_gql_client/lib/assets/hetu/spotify_gql_api_client.ht'
import { SpotifyError } from '../../dependencies/hetu_spotify_gql_client/lib/assets/hetu/error.ht'
import { Converters } from '../converter/converter.ht'

class UserEndpoint {
  var client: SpotifyGqlApi

  construct (this.client)

  fun _simpleArtistFromLibrary(artist: Map) {
    var artistId = artist["uri"]?.split(":").last ?? artist["id"]

    return {
      id: artistId,
      uri: artist["uri"] ?? "spotify:artist:${artistId}",
      name: artist["profile"]?["name"] ?? artist["name"] ?? "",
      external_urls: {
        spotify: "https://open.spotify.com/artist/${artistId}",
      },
      images: artist["visuals"]?["avatarImage"]?["sources"] ?? artist["images"] ?? [],
    }.toJson()
  }

  fun _simpleAlbumFromLibraryItem(item: Map) {
    var wrapper = item["item"] ?? item
    var album = wrapper["data"] ?? wrapper
    var albumId = wrapper["_uri"]?.split(":").last ?? album["uri"]?.split(":").last ?? album["id"]
    var date = album["date"]

    return {
      id: albumId,
      name: album["name"] ?? "",
      external_urls: {
        spotify: "https://open.spotify.com/album/${albumId}",
      },
      release_date:
        date == null
          ? album["release_date"]
          : (
              date["year"] == null
                ? null
                : (
                    date["precision"] == "DAY"
                      ? "${date["year"]}-${date["month"] ?? "01"}-${date["day"] ?? "01"}"
                      : (
                          date["precision"] == "MONTH"
                            ? "${date["year"]}-${date["month"] ?? "01"}"
                            : "${date["year"]}"
                        )
                  )
            ),
      release_date_precision:
        date == null
          ? (album["release_date_precision"] ?? "year")
          : (date["precision"]?.toLowerCase() ?? "year"),
      artists: album["artists"]?["items"]?.map((artist) => _simpleArtistFromLibrary(artist)).toList() ?? [],
      images: album["coverArt"]?["sources"] ?? album["images"] ?? [],
      album_type: album["type"]?.toLowerCase() ?? album["album_type"] ?? "album",
    }.toJson()
  }

  fun _fullArtistFromLibraryItem(item: Map) {
    var wrapper = item["item"] ?? item
    var artist = wrapper["data"] ?? wrapper
    var artistId = wrapper["_uri"]?.split(":").last ?? artist["uri"]?.split(":").last ?? artist["id"]

    return {
      id: artistId,
      name: artist["profile"]?["name"] ?? artist["name"] ?? "",
      external_urls: {
        spotify: "https://open.spotify.com/artist/${artistId}",
      },
      images: artist["visuals"]?["avatarImage"]?["sources"] ?? artist["images"] ?? [],
      genres: artist["genres"] ?? [],
      followers: artist["stats"]?["followers"] ?? artist["followers"]?["total"],
    }.toJson()
  }
  
  fun me() {
    return client.user.me().then((data){
      return Converters.simpleUser(data)
    })
  }

  fun savedTracks({ offset: int, limit: int }) {
    return client.user.savedTracks(offset: offset, limit: limit).then(
      (data) => Converters.paginated(data, (items) => Converters.fullTracks(items))
    )
  }

  fun savedPlaylists({ offset: int, limit: int }) {
    return client.user.savedPlaylists(offset: offset, limit: limit).then((data){           
      return Converters.paginated(
        data, 
        (items) => Converters.simplePlaylistsFromLibraryV3(data["items"])
      )
    })
  }

  fun savedAlbums({ offset: int, limit: int }) {
    return client.gqlClient.post(
      "",
      data: {
        "variables": {
          "filters": ["Albums"],
          "order": null,
          "textFilter": "",
          "features": [
            "LIKED_SONGS",
            "YOUR_EPISODES_V2",
            "PRERELEASES",
            "EVENTS"
          ],
          "limit": limit ?? 20,
          "offset": offset ?? 0,
          "flatten": false,
          "expandedFolders": [],
          "folderUri": null,
          "includeFoldersWhenFlattening": true
        },
        "operationName": "libraryV3",
        "extensions": {
          "persistedQuery": {
            "version": 1,
            "sha256Hash": "2de10199b2441d6e4ae875f27d2db361020c399fb10b03951120223fbed10b08"
          }
        }
      }.toJson()
    ).then((res){
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }

      var albumsData = data["data"]["me"]["libraryV3"]
      var pagingInfo = albumsData["pagingInfo"]
      var items = albumsData["items"]
        .where((item) =>
          (item["item"]?["__typename"] == "AlbumResponseWrapper"
            || item["__typename"] == "AlbumResponseWrapper"
            || item["item"]?["data"]?["__typename"] == "Album")
          && item["item"]?["data"] != null
        )
        .map((item) => _simpleAlbumFromLibraryItem(item))
        .toList()

      var hasMore = albumsData["totalCount"] > ((pagingInfo["offset"] ?? 0) + items.length)

      return {
        limit: pagingInfo["limit"] ?? (limit ?? 20),
        nextOffset: hasMore ? ((pagingInfo["offset"] ?? 0) + (pagingInfo["limit"] ?? (limit ?? 20))) : null,
        hasMore: hasMore,
        total: albumsData["totalCount"] ?? items.length,
        items: items,
      }.toJson()
    })
  }

  fun savedArtists({ offset: int, limit: int }) {
    return client.gqlClient.post(
      "",
      data: {
        "variables": {
          "filters": ["Artists"],
          "order": null,
          "textFilter": "",
          "features": [
            "LIKED_SONGS",
            "YOUR_EPISODES_V2",
            "PRERELEASES",
            "EVENTS"
          ],
          "limit": limit ?? 20,
          "offset": offset ?? 0,
          "flatten": false,
          "expandedFolders": [],
          "folderUri": null,
          "includeFoldersWhenFlattening": true
        },
        "operationName": "libraryV3",
        "extensions": {
          "persistedQuery": {
            "version": 1,
            "sha256Hash": "2de10199b2441d6e4ae875f27d2db361020c399fb10b03951120223fbed10b08"
          }
        }
      }.toJson()
    ).then((res){
      var data = res.data

      if (SpotifyError.isError(data)) {
        throw SpotifyError(data)
      }

      var artistData = data["data"]["me"]["libraryV3"]
      var pagingInfo = artistData["pagingInfo"]
      var items = artistData["items"]
        .where((item) =>
          (item["item"]?["__typename"] == "ArtistResponseWrapper"
            || item["__typename"] == "ArtistResponseWrapper"
            || item["item"]?["data"]?["__typename"] == "Artist")
          && item["item"]?["data"] != null
        )
        .map((item) => _fullArtistFromLibraryItem(item))
        .toList()

      var hasMore = artistData["totalCount"] > ((pagingInfo["offset"] ?? 0) + items.length)

      return {
        limit: pagingInfo["limit"] ?? (limit ?? 20),
        nextOffset: hasMore ? ((pagingInfo["offset"] ?? 0) + (pagingInfo["limit"] ?? (limit ?? 20))) : null,
        hasMore: hasMore,
        total: artistData["totalCount"] ?? items.length,
        items: items,
      }.toJson()
    })
  }

  fun isSavedPlaylist(playlistId: string) { // Future<bool>
    return client.user.isPlaylistSaved(playlistId)
  }

  fun isSavedTracks(trackIds: List) { // Future<List<bool>>
    return client.user.isTracksSaved(trackIds)
  }

  fun isSavedAlbums(albumIds: List) { // Future<List<bool>>
    return client.user.isInLibrary(albumIds, itemType: "album")
  }

  fun isSavedArtists(artistIds: List) { // Future<List<bool>>
    return client.user.isInLibrary(artistIds, itemType: "artist")
  }
}

export { UserEndpoint }
