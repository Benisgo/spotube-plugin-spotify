import "module:std" as std
import "module:spotify_gql_api_client" as spotify
import { Converters } from '../converter/converter.ht'

var HttpClient = std.HttpClient
var HttpResponse = std.HttpResponse
var SpotifyGqlApi = spotify.SpotifyGqlApi

class UserEndpoint {
  var client: SpotifyGqlApi

  construct (this.client)

  fun _isSpotifyError(value) -> bool {
    return value is Map && value["error"] != null
  }

  fun _throwSpotifyError(value) {
    var error = value["error"] ?? {}
    throw {
      status: error["status"],
      message: error["message"] ?? "Spotify request failed",
    }.toJson()
  }

  fun _safeString(value, fallback = "") {
    return value == null ? fallback : "${value}"
  }

  fun _safeImages(images) {
    if (images == null) {
      return []
    }

    if (images is Map) {
      return _safeImages(images["sources"] ?? images["items"])
    }

    var normalized = List()

    for (var image in images ?? []) {
      if (image == null) continue

      if (image["url"] != null) {
        normalized.add({
          url: _safeString(image["url"]),
          width: image["width"],
          height: image["height"],
        }.toJson())
        continue
      }

      if (image["sources"] != null) {
        normalized.addAll(_safeImages(image["sources"]))
        continue
      }

      if (image["items"] != null) {
        normalized.addAll(_safeImages(image["items"]))
      }
    }

    return normalized
  }

  fun _simpleArtistFromLibrary(artist: Map) {
    var artistId = _safeString(artist["uri"]?.split(":").last ?? artist["id"])

    return {
      id: artistId,
      name: _safeString(artist["profile"]?["name"] ?? artist["name"]),
      externalUri: artistId == "" ? "" : "https://open.spotify.com/artist/${artistId}",
      images: _safeImages(artist["visuals"]?["avatarImage"]?["sources"] ?? artist["images"]),
    }.toJson()
  }

  fun _simpleAlbumFromLibraryItem(item: Map) {
    var wrapper = item["item"] ?? item
    var album = wrapper["data"] ?? wrapper
    var albumId = _safeString(wrapper["_uri"]?.split(":").last ?? album["uri"]?.split(":").last ?? album["id"])
    var date = album["date"]

    return {
      id: albumId,
      name: _safeString(album["name"]),
      externalUri: albumId == "" ? "" : "https://open.spotify.com/album/${albumId}",
      releaseDate:
        date == null
          ? _safeString(album["release_date"])
          : (
              date["year"] == null
                ? ""
                : (
                    date["precision"] == "DAY"
                      ? "${date["year"]}-${date["month"] ?? "01"}-${date["day"] ?? "01"}"
                      : (
                          date["precision"] == "MONTH"
                            ? "${date["year"]}-${date["month"] ?? "01"}"
                            : "${date["year"]}"
                        )
                  )
            ),
      artists: album["artists"]?["items"]?.where((artist) => artist != null).map((artist) => _simpleArtistFromLibrary(artist)).toList() ?? [],
      images: _safeImages(album["coverArt"]?["sources"] ?? album["images"]),
      albumType: (album["type"]?.toLowerCase() == "ep" || album["album_type"] == "ep")
        ? "compilation"
        : (album["type"]?.toLowerCase() ?? album["album_type"] ?? "album"),
    }.toJson()
  }

  fun _fullArtistFromLibraryItem(item: Map) {
    var wrapper = item["item"] ?? item
    var artist = wrapper["data"] ?? wrapper
    var artistId = _safeString(wrapper["_uri"]?.split(":").last ?? artist["uri"]?.split(":").last ?? artist["id"])

    return {
      id: artistId,
      name: _safeString(artist["profile"]?["name"] ?? artist["name"]),
      externalUri: artistId == "" ? "" : "https://open.spotify.com/artist/${artistId}",
      images: _safeImages(artist["visuals"]?["avatarImage"]?["sources"] ?? artist["images"]),
      genres: artist["genres"] ?? [],
      followers: artist["stats"]?["followers"] ?? artist["followers"]?["total"],
    }.toJson()
  }

  fun _simplePlaylistFromLibraryItem(item: Map) {
    var wrapper = item["item"] ?? item
    var playlist = wrapper["data"] ?? wrapper
    var visuals = playlist["visuals"] ?? wrapper["visuals"] ?? {}
    var playlistId = _safeString(wrapper["_uri"]?.split(":").last ?? playlist["uri"]?.split(":").last ?? playlist["id"])
    var owner = playlist["ownerV2"]?["data"] ?? playlist["owner"] ?? {}
    var ownerId = _safeString(owner["uri"]?.split(":").last ?? owner["id"])

    return {
      id: playlistId,
      name: _safeString(playlist["name"]),
      description: _safeString(playlist["description"]),
      externalUri: playlistId == "" ? "" : "https://open.spotify.com/playlist/${playlistId}",
      images: _safeImages(
        playlist["images"]
          ?? visuals["avatarImage"]?["sources"]
          ?? visuals["image"]?["sources"]
          ?? playlist["coverArt"]?["sources"]
      ),
      owner: {
        id: ownerId,
        name: _safeString(owner["name"] ?? owner["display_name"]),
        images: _safeImages(owner["images"] ?? owner["avatar"]?["sources"]),
        externalUri: ownerId == "" ? "" : "https://open.spotify.com/user/${ownerId}",
      }.toJson(),
    }.toJson()
  }

  fun _simplePlaylistFromApiPlaylist(playlist: Map) {
    var owner = playlist["owner"] ?? {}
    var ownerId = _safeString(owner["id"] ?? owner["uri"]?.split(":").last)

    return {
      id: _safeString(playlist["id"] ?? playlist["uri"]?.split(":").last),
      name: _safeString(playlist["name"]),
      description: _safeString(playlist["description"]),
      externalUri: _safeString(
        playlist["external_urls"]?["spotify"]
          ?? (playlist["id"] == null ? "" : "https://open.spotify.com/playlist/${playlist["id"]}")
      ),
      images: _safeImages(playlist["images"]),
      owner: {
        id: ownerId,
        name: _safeString(owner["name"] ?? owner["display_name"]),
        images: _safeImages(owner["images"]),
        externalUri: ownerId == "" ? "" : "https://open.spotify.com/user/${ownerId}",
      }.toJson(),
    }.toJson()
  }

  fun _fetchLibraryPlaylists() {
    return client.gqlClient.post(
      "",
      data: {
        "variables": {
          "filters": ["Playlists"],
          "order": null,
          "textFilter": "",
          "features": [
            "LIKED_SONGS",
            "YOUR_EPISODES_V2",
            "PRERELEASES",
            "EVENTS"
          ],
          "limit": 500,
          "offset": 0,
          "flatten": true,
          "expandedFolders": [],
          "folderUri": null,
          "includeFoldersWhenFlattening": true
        },
        "operationName": "libraryV3",
        "extensions": {
          "persistedQuery": {
            "version": 1,
            "sha256Hash": "2de10199b2441d6e4ae875f27d2db361020c399fb10b03951120223fbed10b08"
          }
        }
      }.toJson()
    ).then((res){
      var data = res.data

      if (_isSpotifyError(data)) {
        _throwSpotifyError(data)
      }

      var playlistsData = data["data"]?["me"]?["libraryV3"] ?? {}
      var items = playlistsData["items"] ?? []
      var playlists = List()
      var seen = Map()

      for (var item in items) {
        if (item == null) continue
        if (!_isPlaylistLibraryItem(item)) continue

        var playlist = _simplePlaylistFromLibraryItem(item)
        var key = _safeString(playlist["id"] ?? playlist["externalUri"])
        if (key == "") continue
        if (seen[key] == true) continue

        seen[key] = true
        playlists.add(playlist)
      }

      return playlists
    })
  }

  fun _isPlaylistLibraryItem(item: Map) -> bool {
    var wrapper = item["item"] ?? item
    var data = wrapper["data"] ?? wrapper
    var typename = wrapper["__typename"] ?? item["__typename"] ?? data["__typename"]
    var uri = _safeString(wrapper["_uri"] ?? data["uri"] ?? item["_uri"])
    var objectType = _safeString(item["objectType"] ?? wrapper["objectType"] ?? data["objectType"])

    return typename == "PlaylistResponseWrapper"
      || typename == "Playlist"
      || objectType == "Playlist"
      || uri.startsWith("spotify:playlist:")
  }

  fun me() {
    return client.user.me().then((data){
      return Converters.simpleUser(data)
    })
  }

  fun savedTracks({ offset: int, limit: int }) {
    return client.user.savedTracks(offset: offset, limit: limit).then(
      (data) => Converters.paginated(data, (items) => Converters.fullTracks(items))
    )
  }

  fun savedPlaylists({ offset: int, limit: int }) {
    return _fetchLibraryPlaylists().then((libraryItems){
      var safeOffset = offset ?? 0
      var safeLimit = limit ?? 50
      var pageItems = (libraryItems ?? []).skip(safeOffset).take(safeLimit).toList()
      var nextOffset = safeOffset + safeLimit
      var hasMore = (libraryItems ?? []).length > nextOffset

      return {
        limit: safeLimit,
        nextOffset: hasMore ? nextOffset : null,
        hasMore: hasMore,
        total: (libraryItems ?? []).length,
        items: pageItems,
      }.toJson()
    })
  }

  fun savedAlbums({ offset: int, limit: int }) {
    return client.gqlClient.post(
      "",
      data: {
        "variables": {
          "filters": ["Albums"],
          "order": null,
          "textFilter": "",
          "features": [
            "LIKED_SONGS",
            "YOUR_EPISODES_V2",
            "PRERELEASES",
            "EVENTS"
          ],
          "limit": limit ?? 20,
          "offset": offset ?? 0,
          "flatten": false,
          "expandedFolders": [],
          "folderUri": null,
          "includeFoldersWhenFlattening": true
        },
        "operationName": "libraryV3",
        "extensions": {
          "persistedQuery": {
            "version": 1,
            "sha256Hash": "2de10199b2441d6e4ae875f27d2db361020c399fb10b03951120223fbed10b08"
          }
        }
      }.toJson()
    ).then((res){
      var data = res.data

      if (_isSpotifyError(data)) {
        _throwSpotifyError(data)
      }

      var albumsData = data["data"]["me"]["libraryV3"]
      var pagingInfo = albumsData["pagingInfo"]
      var items = albumsData["items"]
        .where((item) =>
          (item["item"]?["__typename"] == "AlbumResponseWrapper"
            || item["__typename"] == "AlbumResponseWrapper"
            || item["item"]?["data"]?["__typename"] == "Album")
          && item["item"]?["data"] != null
        )
        .map((item) => _simpleAlbumFromLibraryItem(item))
        .toList()

      var hasMore = albumsData["totalCount"] > ((pagingInfo["offset"] ?? 0) + items.length)

      return {
        limit: pagingInfo["limit"] ?? (limit ?? 20),
        nextOffset: hasMore ? ((pagingInfo["offset"] ?? 0) + (pagingInfo["limit"] ?? (limit ?? 20))) : null,
        hasMore: hasMore,
        total: albumsData["totalCount"] ?? items.length,
        items: items,
      }.toJson()
    })
  }

  fun savedArtists({ offset: int, limit: int }) {
    return client.gqlClient.post(
      "",
      data: {
        "variables": {
          "filters": ["Artists"],
          "order": null,
          "textFilter": "",
          "features": [
            "LIKED_SONGS",
            "YOUR_EPISODES_V2",
            "PRERELEASES",
            "EVENTS"
          ],
          "limit": limit ?? 20,
          "offset": offset ?? 0,
          "flatten": false,
          "expandedFolders": [],
          "folderUri": null,
          "includeFoldersWhenFlattening": true
        },
        "operationName": "libraryV3",
        "extensions": {
          "persistedQuery": {
            "version": 1,
            "sha256Hash": "2de10199b2441d6e4ae875f27d2db361020c399fb10b03951120223fbed10b08"
          }
        }
      }.toJson()
    ).then((res){
      var data = res.data

      if (_isSpotifyError(data)) {
        _throwSpotifyError(data)
      }

      var artistData = data["data"]["me"]["libraryV3"]
      var pagingInfo = artistData["pagingInfo"]
      var items = artistData["items"]
        .where((item) =>
          (item["item"]?["__typename"] == "ArtistResponseWrapper"
            || item["__typename"] == "ArtistResponseWrapper"
            || item["item"]?["data"]?["__typename"] == "Artist")
          && item["item"]?["data"] != null
        )
        .map((item) => _fullArtistFromLibraryItem(item))
        .toList()

      var hasMore = artistData["totalCount"] > ((pagingInfo["offset"] ?? 0) + items.length)

      return {
        limit: pagingInfo["limit"] ?? (limit ?? 20),
        nextOffset: hasMore ? ((pagingInfo["offset"] ?? 0) + (pagingInfo["limit"] ?? (limit ?? 20))) : null,
        hasMore: hasMore,
        total: artistData["totalCount"] ?? items.length,
        items: items,
      }.toJson()
    })
  }

  fun isSavedPlaylist(playlistId: string) { // Future<bool>
    return client.user.isPlaylistSaved(playlistId)
  }

  fun isSavedTracks(trackIds: List) { // Future<List<bool>>
    return client.user.isTracksSaved(trackIds)
  }

  fun isSavedAlbums(albumIds: List) { // Future<List<bool>>
    return client.user.isInLibrary(albumIds, itemType: "album")
  }

  fun isSavedArtists(artistIds: List) { // Future<List<bool>>
    return client.user.isInLibrary(artistIds, itemType: "artist")
  }
}

export { UserEndpoint }
